{
  "name": "dynamolive-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build:dev": "npm run typecheck && vite build --mode dev",
    "build:live": "npm run typecheck && vite build --mode live",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-transform-types --test src/test/*.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "gsap": "3.15.0",
    "qrcode": "1.5.4",
    "svelte": "5.57.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/qrcode": "1.5.5",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
