# Uso: npm run build:dev (vite --mode dev)
# Build per lo stack AWS "dynamolive-dev" (sam deploy --config-env dev).
# Compilare API Gateway URL e dominio CloudFront dopo il deploy SAM (vedi Outputs dello stack).
VITE_API_BASE=https://REPLACE-CON-API-GATEWAY-DEV.execute-api.eu-central-1.amazonaws.com
VITE_SESSION=prova-01
VITE_PUBLIC_ORIGIN=https://REPLACE-CON-DOMINIO-CLOUDFRONT-DEV
VITE_DOCUMENT_URL=/dynamolive-approfondimento.pdf
VITE_BACKUP_URL=/backup.mp4

# Fallback locale (tasto L sullo stage): richiede DynamoDB Local + `npm run dev:api`
# attivi sul portatile durante i test.
VITE_LOCAL_API=http://localhost:3001
VITE_LOCAL_SESSION=prova-01
