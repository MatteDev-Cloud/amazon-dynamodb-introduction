# Uso: npm run build:live (vite --mode live)
# Build per lo stack AWS "dynamolive-live" (sam deploy --config-env live) — il talk vero.
# Compilare API Gateway URL e dominio CloudFront dopo il deploy SAM (vedi Outputs dello stack).
VITE_API_BASE=https://REPLACE-CON-API-GATEWAY-LIVE.execute-api.eu-central-1.amazonaws.com
VITE_SESSION=talk-01
VITE_PUBLIC_ORIGIN=https://REPLACE-CON-DOMINIO-CLOUDFRONT-LIVE
VITE_DOCUMENT_URL=/dynamolive-approfondimento.pdf
VITE_BACKUP_URL=/backup.mp4

# Fallback locale (tasto L, Piano B livello 3 "AWS irraggiungibile"): richiede
# DynamoDB Local + `npm run dev:api` attivi sul portatile durante il talk.
VITE_LOCAL_API=http://localhost:3001
VITE_LOCAL_SESSION=talk-01
