# Configurazione LOCALE ONLY per backend/local-server.ts contro DynamoDB Local.
# Non esiste un equivalente "prod" di questo file: su AWS (DEV/LIVE) il backend
# gira come Lambda e la configurazione viene dai parametri SAM in infra/template.yaml
# + infra/samconfig.toml (env "dev" e "live"), non da un .env.
DDB_ENDPOINT=http://127.0.0.1:8000
TABLE_NAME=DynamoLive-local
AWS_REGION=eu-central-1
ADMIN_KEY=local-development-key-change-me
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
